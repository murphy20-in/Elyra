# App Configuration
APP_NAME=Elyra
APP_ENV=development
APP_VERSION=0.1.0
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=false
LOG_LEVEL=INFO

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=elyra_db
POSTGRES_USER=elyra_user
POSTGRES_PASSWORD=postgres_password_change_me

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# MongoDB Configuration
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=elyra_chat

# JWT Configuration
JWT_SECRET_KEY=jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption
AES_ENCRYPTION_KEY=32-character-encryption-key-here

# AI Services
EMBEDDING_SERVICE_URL=http://localhost:9001
MODERATION_SERVICE_URL=http://localhost:9002
IMAGE_SERVICE_URL=http://localhost:9003
FAKE_PROFILE_SERVICE_URL=http://localhost:9004

# LLM Configuration
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LOCAL_LLM_URL=http://localhost:11434

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
AUTH_RATE_LIMIT_PER_MINUTE=10
WS_MESSAGE_RATE_LIMIT=20

# Storage (S3/MinIO)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=elyra-media
S3_ACCESS_KEY=minio_access_key
S3_SECRET_KEY=minio_secret_key
S3_REGION=ap-south-1
MAX_PHOTO_SIZE_MB=5

# Email (SMTP)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@elyra.app

# SMS (Twilio)
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Push Notifications (FCM/APNS)
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=

# Payment (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Observability
SENTRY_DSN=
PROMETHEUS_ENABLED=true