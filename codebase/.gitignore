# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml
test-results.xml
*.log

# ── Virtual environments ──────────────────────────────────────────────────────
venv/
.venv/
env/
.env.local
.env.*.local

# ── Environment files (NEVER commit secrets) ──────────────────────────────────
.env
backend/.env
frontend/.env.local
!.env.example
!backend/.env.example
!frontend/.env.local.example

# ── Next.js / Node ────────────────────────────────────────────────────────────
node_modules/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Docker ────────────────────────────────────────────────────────────────────
*.tar

# ── IDE ───────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── AI model weights (too large for git) ─────────────────────────────────────
*.bin
*.pt
*.pth
*.ckpt
ai-services/*/models/
ai-services/*/cache/

# ── Kubernetes secrets (use sealed-secrets instead) ───────────────────────────
infra/k8s/base/secrets-real.yaml
infra/k8s/overlays/*/secrets-real.yaml

# ── Test output ─────────────────────────────────────────────────────────────
backend/tests/output/
frontend/playwright-report/
frontend/test-results/

# ── Build artifacts ───────────────────────────────────────────────────────────
backend/alembic/versions/*.pyc